# Gateway: AHT10 + DS3231 → Arduino Uno → laptop → Render
# Ver ../README.md
#
# Puerto COM del Arduino (USB). Administrador de dispositivos → Puertos (COM y LPT)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Backend Nativa — Render (examen / demo):
API_URL=https://app-harinas.onrender.com/api/arduino/telemetry
# Local: API_URL=http://localhost:4000/api/arduino/telemetry

# Cold start Render free: timeout largo + reintentos
API_TIMEOUT_MS=90000
API_RETRIES=3

# Solo si hay cert self-signed (ngrok raro); en Render deja 0
API_INSECURE_TLS=0

# Si el Uno emite JSON legacy { temperature, humidity } (sin deviceId),
# el gateway completa estos campos:
DEVICE_ID=uno-secador-01
CODIGO_GRUPO=garbanzo-lenteja

# 1 = espera hasta que aparezca SERIAL_PORT (útil antes de enchufar el Uno)
WAIT_FOR_PORT=1
PORT_POLL_MS=3000
