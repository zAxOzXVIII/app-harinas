# Plantilla de variables para Render (copiar al dashboard del servicio)
# No subir con contraseñas reales al repo.

PORT=4000
NODE_ENV=production
TRUST_PROXY=1
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PUSH_NOTIFICATIONS_ENABLED=true
CORS_ORIGINS=*

